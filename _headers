/*
X-Content-Type-Options: nosniff
X-Frame-Options: SAMEORIGIN
Referrer-Policy: strict-origin-when-cross-origin
Permissions-Policy: geolocation=(), microphone=(), camera=()
Strict-Transport-Security: max-age=31536000; includeSubDomains
Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://media.valorandserenity.com; script-src 'self';

/*.html
Cache-Control: public, max-age=3600, must-revalidate

/images/*
Cache-Control: public, max-age=31536000, immutable

/js/*
Cache-Control: public, max-age=600, must-revalidate

/*.xml
Cache-Control: public, max-age=3600

/*.txt
Content-Type: text/plain; charset=utf-8

/robots.txt
Cache-Control: public, max-age=86400
